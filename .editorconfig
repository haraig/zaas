# EditorConfig - https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Go uses tabs (enforced by gofmt)
[*.go]
indent_style = tab
indent_size = 4

# Makefile requires tabs
[Makefile]
indent_style = tab

# Terraform convention
[*.tf]
indent_size = 2

# Trailing spaces are meaningful line breaks in Markdown
[*.md]
trim_trailing_whitespace = false

# Shell scripts
[*.sh]
indent_size = 2
