---
// ApiCallPanel: collapsible panel showing the curl command and raw JSON response.
// Content is populated dynamically by the tool page's script via data attributes.
---

<details data-api-panel class="rounded-lg border border-border dark:border-border-dark mt-6">
  <summary
    class="px-4 py-3 cursor-pointer text-sm font-medium text-text-secondary dark:text-text-secondary-dark hover:text-accent transition-colors select-none"
  >
    Show API Call
  </summary>
  <div class="px-4 pb-4 space-y-4">
    <div>
      <div class="flex items-center justify-between mb-1">
        <span
          class="text-xs font-semibold uppercase tracking-wide text-text-secondary dark:text-text-secondary-dark"
          >curl command</span
        >
        <button
          type="button"
          data-panel-copy-btn
          data-copy-target="api-panel-curl"
          class="inline-flex items-center gap-1 px-2 py-1 rounded text-xs font-medium text-text-secondary dark:text-text-secondary-dark hover:text-accent transition-colors"
          aria-label="Copy curl command"
        >
          <svg
            data-copy-icon
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
            ></path>
          </svg>
          <svg
            data-check-icon
            class="hidden w-3.5 h-3.5 text-success dark:text-success-dark"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>
      <pre
        id="api-panel-curl"
        class="rounded bg-surface-alt dark:bg-surface-alt-dark p-3 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-all">
      </pre>
    </div>
    <div>
      <div class="flex items-center justify-between mb-1">
        <span
          class="text-xs font-semibold uppercase tracking-wide text-text-secondary dark:text-text-secondary-dark"
          >Response</span
        >
        <button
          type="button"
          data-panel-copy-btn
          data-copy-target="api-panel-response"
          class="inline-flex items-center gap-1 px-2 py-1 rounded text-xs font-medium text-text-secondary dark:text-text-secondary-dark hover:text-accent transition-colors"
          aria-label="Copy response JSON"
        >
          <svg
            data-copy-icon
            class="w-3.5 h-3.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z"
            ></path>
          </svg>
          <svg
            data-check-icon
            class="hidden w-3.5 h-3.5 text-success dark:text-success-dark"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
          </svg>
          <span data-copy-label>Copy</span>
        </button>
      </div>
      <pre
        id="api-panel-response"
        class="rounded bg-surface-alt dark:bg-surface-alt-dark p-3 text-xs font-mono overflow-x-auto whitespace-pre-wrap break-all">
      </pre>
    </div>
  </div>
</details>

<script>
  // Copy buttons inside ApiCallPanel - self-contained, does not conflict with CopyButton component.
  document.querySelectorAll<HTMLButtonElement>("[data-panel-copy-btn]").forEach((btn) => {
    btn.addEventListener("click", async () => {
      const targetId = btn.dataset.copyTarget!;
      const target = document.getElementById(targetId);
      if (!target) return;

      const text = target.textContent?.trim() ?? "";
      await navigator.clipboard.writeText(text);

      const copyIcon = btn.querySelector("[data-copy-icon]") as HTMLElement;
      const checkIcon = btn.querySelector("[data-check-icon]") as HTMLElement;
      const label = btn.querySelector("[data-copy-label]") as HTMLElement;

      copyIcon.classList.add("hidden");
      checkIcon.classList.remove("hidden");
      label.textContent = "Copied!";

      setTimeout(() => {
        copyIcon.classList.remove("hidden");
        checkIcon.classList.add("hidden");
        label.textContent = "Copy";
      }, 2000);
    });
  });
</script>
