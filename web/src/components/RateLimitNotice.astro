---
// RateLimitNotice: displays rate limit info from API response headers.
// Hidden by default; populated by the tool page script after an API call.
---

<div
  data-rate-limit-notice
  aria-live="polite"
  class="hidden mt-4 text-xs text-text-secondary dark:text-text-secondary-dark"
>
  <!-- ok state: request succeeded -->
  <span
    data-rate-limit-ok
    class="inline-flex items-center gap-1"
    title="You have this many API requests remaining in the current 1-minute window."
  >
    <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
    </svg>
    <span data-rate-limit-text></span>
  </span>

  <!-- error state: 429 response received -->
  <span
    data-rate-limit-error
    class="inline-flex items-center gap-1 text-error dark:text-error-dark font-medium"
    style="display:none"
    title="You have exceeded the rate limit. Register for a free API key to get a higher limit."
  >
    <svg aria-hidden="true" class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"
      ></path>
    </svg>
    <span data-rate-limit-error-text></span>
  </span>
</div>
