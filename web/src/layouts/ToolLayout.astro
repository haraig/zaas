---
import BaseLayout from "./BaseLayout.astro";

interface Props {
  title: string;
  heading: string;
  description: string;
}

const { title, heading, description } = Astro.props;
---

<BaseLayout title={`${title} - ZaaS`} description={description}>
  <section class="py-12 sm:py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10">
        <h1 class="text-3xl sm:text-4xl font-bold tracking-tight">{heading}</h1>
        <p class="mt-3 text-text-secondary dark:text-text-secondary-dark max-w-xl mx-auto">
          {description}
        </p>
      </div>
      <slot />
    </div>
  </section>
</BaseLayout>
