---
import ToolLayout from "../../layouts/ToolLayout.astro";
import GenerateButton from "../../components/GenerateButton.astro";
import CopyButton from "../../components/CopyButton.astro";
import ApiCallPanel from "../../components/ApiCallPanel.astro";

import RateLimitNotice from "../../components/RateLimitNotice.astro";
---

<ToolLayout
  title="Dice Roller"
  heading="Dice Roller"
  description="Roll standard RPG dice - d4, d6, d8, d10, d12, d20, or d100."
>
  <!-- Controls -->
  <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-end justify-center mb-8">
    <div>
      <label for="dice-sides" class="block text-sm font-medium mb-1">Sides</label>
      <select
        id="dice-sides"
        class="rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent"
      >
        <option value="4">d4</option>
        <option value="6" selected>d6</option>
        <option value="8">d8</option>
        <option value="10">d10</option>
        <option value="12">d12</option>
        <option value="20">d20</option>
        <option value="100">d100</option>
      </select>
    </div>
    <div>
      <label for="dice-count" class="block text-sm font-medium mb-1">Count</label>
      <input
        type="number"
        id="dice-count"
        min="1"
        max="100"
        value="1"
        class="w-24 rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent"
      />
    </div>
    <GenerateButton label="Roll" loadingLabel="Rolling..." />
  </div>

  <!-- Result -->
  <div
    id="dice-result-container"
    class="hidden rounded-lg border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-alt-dark p-6"
  >
    <div class="flex items-start justify-between gap-2">
      <div id="dice-result" class="font-mono text-lg flex-1"></div>
      <CopyButton targetId="dice-result" />
    </div>
  </div>

  <!-- Error -->
  <div
    id="dice-error"
    role="alert" class="hidden rounded-lg border border-error/30 dark:border-error-dark/30 bg-error/5 dark:bg-error-dark/5 p-4 text-sm text-error dark:text-error-dark"
  >
  </div>

  <!-- Rate Limit Notice -->
  <RateLimitNotice />

  <!-- API Call Panel -->
  <ApiCallPanel />
</ToolLayout>

<script>
  import { initToolRunner } from "../../scripts/toolRunner";

  const sidesSelect = document.getElementById("dice-sides") as HTMLSelectElement;
  const countInput = document.getElementById("dice-count") as HTMLInputElement;
  const resultEl = document.getElementById("dice-result")!;

  initToolRunner({
    resultContainerId: "dice-result-container",
    errorElId: "dice-error",
    buildPath() {
      const sides = sidesSelect.value;
      const count = Math.max(1, Math.min(100, parseInt(countInput.value, 10) || 1));
      countInput.value = String(count);

      const params = new URLSearchParams();
      if (sides !== "6") params.set("sides", sides);
      if (count !== 1) params.set("count", String(count));

      return `/api/v1/dice${params.toString() ? "?" + params.toString() : ""}`;
    },
    renderResults(json) {
      const data = json as { result?: number; results?: number[] };
      const count = parseInt(countInput.value, 10) || 1;
      const values = count === 1 ? [data.result] : data.results ?? [];
      resultEl.textContent = values.join(", ");
    },
  });
</script>
