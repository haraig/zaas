---
import ToolLayout from "../../layouts/ToolLayout.astro";
import GenerateButton from "../../components/GenerateButton.astro";
import CopyButton from "../../components/CopyButton.astro";
import ApiCallPanel from "../../components/ApiCallPanel.astro";

import RateLimitNotice from "../../components/RateLimitNotice.astro";
---

<ToolLayout
  title="UUID Generator"
  heading="UUID Generator"
  description="Generate version 4 UUIDs in standard, no-dashes, or URN format."
>
  <!-- Controls -->
  <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-end justify-center mb-8">
    <div>
      <label for="uuid-count" class="block text-sm font-medium mb-1">Count</label>
      <input
        type="number"
        id="uuid-count"
        min="1"
        max="100"
        value="1"
        class="w-24 rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent"
      />
    </div>
    <div>
      <label for="uuid-format" class="block text-sm font-medium mb-1">Format</label>
      <select
        id="uuid-format"
        class="rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent"
      >
        <option value="standard">Standard</option>
        <option value="no-dashes">No Dashes</option>
        <option value="urn">URN</option>
      </select>
    </div>
    <GenerateButton />
  </div>

  <!-- Result -->
  <div
    id="uuid-result-container"
    class="hidden rounded-lg border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-alt-dark p-6"
  >
    <div class="flex items-start justify-between gap-2">
      <pre id="uuid-result" class="font-mono text-lg break-all whitespace-pre-wrap flex-1"></pre>
      <CopyButton targetId="uuid-result" />
    </div>
  </div>

  <!-- Error -->
  <div
    id="uuid-error"
    role="alert" class="hidden rounded-lg border border-error/30 dark:border-error-dark/30 bg-error/5 dark:bg-error-dark/5 p-4 text-sm text-error dark:text-error-dark"
  >
  </div>

  <!-- Rate Limit Notice -->
  <RateLimitNotice />

  <!-- API Call Panel -->
  <ApiCallPanel />
</ToolLayout>

<script>
  import { initToolRunner } from "../../scripts/toolRunner";

  const countInput = document.getElementById("uuid-count") as HTMLInputElement;
  const formatSelect = document.getElementById("uuid-format") as HTMLSelectElement;
  const resultEl = document.getElementById("uuid-result")!;

  initToolRunner({
    resultContainerId: "uuid-result-container",
    errorElId: "uuid-error",
    buildPath() {
      const count = Math.max(1, Math.min(100, parseInt(countInput.value, 10) || 1));
      const format = formatSelect.value;
      countInput.value = String(count);

      const params = new URLSearchParams();
      if (count !== 1) params.set("count", String(count));
      if (format !== "standard") params.set("format", format);

      return `/api/v1/uuid${params.toString() ? "?" + params.toString() : ""}`;
    },
    renderResults(json) {
      const data = json as { result?: string; results?: string[] };
      const count = parseInt(countInput.value, 10) || 1;
      const values = count === 1 ? [data.result] : data.results ?? [];
      resultEl.textContent = values.join("\n");
    },
  });
</script>
