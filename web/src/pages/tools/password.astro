---
import ToolLayout from "../../layouts/ToolLayout.astro";
import GenerateButton from "../../components/GenerateButton.astro";
import CopyButton from "../../components/CopyButton.astro";
import ApiCallPanel from "../../components/ApiCallPanel.astro";

import RateLimitNotice from "../../components/RateLimitNotice.astro";
---

<ToolLayout
  title="Password Generator"
  heading="Password Generator"
  description="Generate secure random passwords with configurable character sets."
>
  <!-- Controls -->
  <div class="flex flex-col sm:flex-row gap-4 items-start sm:items-end justify-center flex-wrap mb-8">
    <div>
      <label for="password-length" class="block text-sm font-medium mb-1">Length</label>
      <input
        type="number"
        id="password-length"
        min="8"
        max="128"
        value="16"
        class="w-24 rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent"
      />
    </div>
    <div>
      <label for="password-count" class="block text-sm font-medium mb-1">Count</label>
      <input
        type="number"
        id="password-count"
        min="1"
        max="100"
        value="1"
        class="w-24 rounded-lg border border-border dark:border-border-dark bg-surface dark:bg-surface-dark px-3 py-2 text-sm focus:outline-none focus:ring-2 focus:ring-accent"
      />
    </div>
    <fieldset class="flex flex-col gap-2">
      <legend class="text-sm font-medium mb-1">Character sets</legend>
      <label class="flex items-center gap-2 text-sm font-medium cursor-pointer">
        <input type="checkbox" id="password-uppercase" checked class="rounded" />
        Uppercase (A-Z)
      </label>
      <label class="flex items-center gap-2 text-sm font-medium cursor-pointer">
        <input type="checkbox" id="password-lowercase" checked class="rounded" />
        Lowercase (a-z)
      </label>
      <label class="flex items-center gap-2 text-sm font-medium cursor-pointer">
        <input type="checkbox" id="password-digits" checked class="rounded" />
        Digits (0-9)
      </label>
      <label class="flex items-center gap-2 text-sm font-medium cursor-pointer">
        <input type="checkbox" id="password-symbols" class="rounded" />
        Symbols (!@#$%^&*)
      </label>
    </fieldset>
    <GenerateButton label="Generate" loadingLabel="Generating..." />
  </div>

  <!-- Result -->
  <div
    id="password-result-container"
    class="hidden rounded-lg border border-border dark:border-border-dark bg-surface-alt dark:bg-surface-alt-dark p-6"
  >
    <div class="flex items-start justify-between gap-2">
      <div id="password-result" class="font-mono text-lg flex-1 whitespace-pre-wrap break-all"></div>
      <CopyButton targetId="password-result" />
    </div>
  </div>

  <!-- Error -->
  <div
    id="password-error"
    role="alert" class="hidden rounded-lg border border-error/30 dark:border-error-dark/30 bg-error/5 dark:bg-error-dark/5 p-4 text-sm text-error dark:text-error-dark"
  >
  </div>

  <!-- Rate Limit Notice -->
  <RateLimitNotice />

  <!-- API Call Panel -->
  <ApiCallPanel />
</ToolLayout>

<script>
  import { initToolRunner } from "../../scripts/toolRunner";

  const lengthInput = document.getElementById("password-length") as HTMLInputElement;
  const countInput = document.getElementById("password-count") as HTMLInputElement;
  const uppercaseInput = document.getElementById("password-uppercase") as HTMLInputElement;
  const lowercaseInput = document.getElementById("password-lowercase") as HTMLInputElement;
  const digitsInput = document.getElementById("password-digits") as HTMLInputElement;
  const symbolsInput = document.getElementById("password-symbols") as HTMLInputElement;
  const resultEl = document.getElementById("password-result")!;

  initToolRunner({
    resultContainerId: "password-result-container",
    errorElId: "password-error",
    buildPath() {
      const length = Math.max(8, Math.min(128, parseInt(lengthInput.value, 10) || 16));
      lengthInput.value = String(length);
      const count = Math.max(1, Math.min(100, parseInt(countInput.value, 10) || 1));
      countInput.value = String(count);

      const params = new URLSearchParams();
      params.set("length", String(length));
      params.set("uppercase", String(uppercaseInput.checked));
      params.set("lowercase", String(lowercaseInput.checked));
      params.set("digits", String(digitsInput.checked));
      params.set("symbols", String(symbolsInput.checked));
      params.set("count", String(count));

      return `/api/v1/password?${params.toString()}`;
    },
    renderResults(json) {
      const data = json as { result?: string; results?: string[] };
      const count = parseInt(countInput.value, 10) || 1;
      const values = count === 1 ? [data.result] : data.results ?? [];
      resultEl.textContent = values.join("\n");
    },
  });
</script>
