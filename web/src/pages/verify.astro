---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Verify Email - ZaaS"
  description="Confirm your email address to receive your ZaaS API key."
>
  <section class="py-12 sm:py-16">
    <div class="max-w-lg mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-4">Verify your email</h1>
      <p class="text-text-secondary dark:text-text-secondary-dark mb-8">
        Click the button below to confirm your email address and receive your API key.
        This link is single-use and expires after 24 hours.
      </p>

      <div id="verify-form">
        <button
          id="verify-btn"
          type="button"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg bg-accent text-white font-semibold hover:bg-accent-hover transition-colors disabled:opacity-50 disabled:cursor-not-allowed"
        >
          Confirm and get API key
        </button>
      </div>

      <div id="result-success" class="hidden mt-8 space-y-4">
        <div class="rounded-lg border border-green-500/30 bg-green-500/10 p-4">
          <p class="font-semibold text-green-700 dark:text-green-400 mb-2">Email verified!</p>
          <p class="text-sm text-text-secondary dark:text-text-secondary-dark mb-3" id="result-message"></p>
          <div class="relative">
            <label class="block text-xs font-semibold uppercase tracking-wide mb-1">Your API key</label>
            <code id="api-key" class="block w-full break-all rounded bg-surface dark:bg-surface-dark border border-border dark:border-border-dark px-3 py-2 text-sm font-mono"></code>
            <button
              id="copy-btn"
              type="button"
              class="mt-2 text-xs text-accent hover:text-accent-hover transition-colors"
            >Copy to clipboard</button>
          </div>
        </div>
      </div>

      <div id="result-error" class="hidden mt-8">
        <div class="rounded-lg border border-red-500/30 bg-red-500/10 p-4">
          <p class="font-semibold text-red-700 dark:text-red-400 mb-1">Verification failed</p>
          <p id="error-message" class="text-sm text-text-secondary dark:text-text-secondary-dark"></p>
          <p class="mt-3 text-sm">
            If your link has expired, email contact@zaas.at to request a new one.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const params = new URLSearchParams(window.location.search);
  const token = params.get("token");
  const type = params.get("type");

  const btn = document.getElementById("verify-btn") as HTMLButtonElement;
  const formEl = document.getElementById("verify-form") as HTMLElement;
  const successEl = document.getElementById("result-success") as HTMLElement;
  const errorEl = document.getElementById("result-error") as HTMLElement;
  const apiKeyEl = document.getElementById("api-key") as HTMLElement;
  const resultMessageEl = document.getElementById("result-message") as HTMLElement;
  const errorMessageEl = document.getElementById("error-message") as HTMLElement;
  const copyBtn = document.getElementById("copy-btn") as HTMLButtonElement;

  if (!token || !type) {
    formEl.classList.add("hidden");
    errorEl.classList.remove("hidden");
    errorMessageEl.textContent = "Missing token or type in the URL. Please use the link from your email.";
  }

  btn.addEventListener("click", async () => {
    btn.disabled = true;
    btn.textContent = "Verifying...";

    const apiBase = document.documentElement.dataset.apiBaseUrl ?? "";

    try {
      const res = await fetch(`${apiBase}/api/v1/auth/verify`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ token, type }),
      });

      const data = await res.json();

      if (res.ok) {
        formEl.classList.add("hidden");
        apiKeyEl.textContent = data.api_key ?? "";
        resultMessageEl.textContent = data.message ?? "";
        successEl.classList.remove("hidden");
      } else {
        formEl.classList.add("hidden");
        errorMessageEl.textContent =
          data?.detail ?? data?.title ?? "An unexpected error occurred. Please try again.";
        errorEl.classList.remove("hidden");
      }
    } catch {
      formEl.classList.add("hidden");
      errorMessageEl.textContent = "Network error. Please check your connection and try again.";
      errorEl.classList.remove("hidden");
    }
  });

  copyBtn.addEventListener("click", async () => {
    const key = apiKeyEl.textContent ?? "";
    try {
      await navigator.clipboard.writeText(key);
      copyBtn.textContent = "Copied!";
      setTimeout(() => {
        copyBtn.textContent = "Copy to clipboard";
      }, 2000);
    } catch {
      copyBtn.textContent = "Copy failed";
    }
  });
</script>
