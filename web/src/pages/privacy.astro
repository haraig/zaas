---
import BaseLayout from "../layouts/BaseLayout.astro";

const requiredVars = [
  "PUBLIC_IMPRINT_NAME",
  "PUBLIC_IMPRINT_ADDRESS",
  "PUBLIC_IMPRINT_EMAIL",
] as const;

if (import.meta.env.PROD) {
  for (const varName of requiredVars) {
    if (!import.meta.env[varName]) {
      throw new Error(
        `Build error: ${varName} is required but not set. ` +
          `Set it in your environment before running the production build.`,
      );
    }
  }
}

const name = import.meta.env.PUBLIC_IMPRINT_NAME || "[Not configured]";
const address = import.meta.env.PUBLIC_IMPRINT_ADDRESS || "[Not configured]";
const email = import.meta.env.PUBLIC_IMPRINT_EMAIL || "[Not configured]";
const privacyEmail = import.meta.env.PUBLIC_PRIVACY_EMAIL || email;
---

<BaseLayout
  title="Privacy Policy - ZaaS"
  description="Privacy policy for ZaaS - Zufall as a Service. We do not store or log any generated results."
  alternates={[
    { hreflang: "en", href: "/privacy" },
    { hreflang: "de", href: "/datenschutz" },
  ]}
>
  <section class="py-12 sm:py-16">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-3xl sm:text-4xl font-bold tracking-tight mb-2">Privacy Policy</h1>
      <p class="text-sm text-text-secondary dark:text-text-secondary-dark mb-8">
        Auf Deutsch: <a
          href="/datenschutz"
          class="text-accent hover:text-accent-hover transition-colors">Datenschutzerklärung</a
        >
      </p>

      <div class="space-y-8 text-text-secondary dark:text-text-secondary-dark">
        <div>
          <h2
            class="text-sm uppercase tracking-wide font-semibold mb-2 text-text-primary dark:text-text-primary-dark"
          >
            1. Data Controller
          </h2>
          <p class="font-medium text-text-primary dark:text-text-primary-dark">{name}</p>
          {address.split("\\n").map((line: string) => <p>{line}</p>)}
          <p class="mt-2">
            Email: <a
              href={`mailto:${email}`}
              class="text-accent hover:text-accent-hover transition-colors">{email}</a
            >
          </p>
        </div>

        <hr class="border-border dark:border-border-dark" />

        <div>
          <h2
            class="text-sm uppercase tracking-wide font-semibold mb-2 text-text-primary dark:text-text-primary-dark"
          >
            2. Generated Results Are Never Stored
          </h2>
          <p>
            ZaaS will never store, log, or retain any results generated by the API - no dice rolls,
            no UUIDs, no random numbers, no colors, no coordinates, and no other outputs are written
            to any persistent storage or log file. Results exist only in the HTTP response sent
            directly to your client.
          </p>
        </div>

        <hr class="border-border dark:border-border-dark" />

        <div>
          <h2
            class="text-sm uppercase tracking-wide font-semibold mb-2 text-text-primary dark:text-text-primary-dark"
          >
            3. Data We Process
          </h2>
          <p class="mb-4">When you use ZaaS, the following technical data is processed:</p>
          <ul class="space-y-3 list-disc list-inside">
            <li>
              <span class="font-medium text-text-primary dark:text-text-primary-dark"
                >IP address</span
              > - processed transiently for rate limiting (held in memory only, never written to disk)
              and recorded in server access logs for operational purposes.
            </li>
            <li>
              <span class="font-medium text-text-primary dark:text-text-primary-dark"
                >HTTP request metadata</span
              > - HTTP method, request path, response status code, and response duration are recorded
              in server logs for operational monitoring. No request or response bodies are logged.
            </li>
            <li>
              <span class="font-medium text-text-primary dark:text-text-primary-dark"
                >Request ID</span
              > - a random identifier generated per request for log correlation. It is not linked to any
              user identity.
            </li>
          </ul>
          <p class="mt-4">
            <span class="font-medium text-text-primary dark:text-text-primary-dark"
              >Legal basis:</span
            > Art. 6(1)(f) GDPR - legitimate interest in ensuring the security, stability, and correct
            operation of the service (rate limiting, abuse prevention, error diagnosis).
          </p>
        </div>

        <hr class="border-border dark:border-border-dark" />

        <div>
          <h2
            class="text-sm uppercase tracking-wide font-semibold mb-2 text-text-primary dark:text-text-primary-dark"
          >
            4. Cookies
          </h2>
          <p>This website does not use cookies.</p>
        </div>

        <hr class="border-border dark:border-border-dark" />

        <div>
          <h2
            class="text-sm uppercase tracking-wide font-semibold mb-2 text-text-primary dark:text-text-primary-dark"
          >
            5. Local Storage
          </h2>
          <p>
            Your theme preference (light or dark mode) is stored in your browser's local storage
            under the key <code
              class="text-sm font-mono bg-surface-alt dark:bg-surface-alt-dark px-1 rounded"
              >theme</code
            >. This data never leaves your device and is never transmitted to the server.
          </p>
        </div>

        <hr class="border-border dark:border-border-dark" />

        <div>
          <h2
            class="text-sm uppercase tracking-wide font-semibold mb-2 text-text-primary dark:text-text-primary-dark"
          >
            6. No Analytics or Tracking
          </h2>
          <p>
            ZaaS uses no analytics services, advertising networks, or third-party tracking scripts.
            No data about your behavior on this site is shared with third parties.
          </p>
        </div>

        <hr class="border-border dark:border-border-dark" />

        <div>
          <h2
            class="text-sm uppercase tracking-wide font-semibold mb-2 text-text-primary dark:text-text-primary-dark"
          >
            7. Infrastructure Providers
          </h2>
          <p>
            ZaaS is hosted on infrastructure provided by third-party providers operating within the
            European Union. These providers may process technical data (such as IP addresses) as
            part of normal infrastructure operation. They are bound by data processing agreements in
            accordance with GDPR Art. 28.
          </p>
        </div>

        <hr class="border-border dark:border-border-dark" />

        <div>
          <h2
            class="text-sm uppercase tracking-wide font-semibold mb-2 text-text-primary dark:text-text-primary-dark"
          >
            8. Map Tiles (Coordinates Tool)
          </h2>
          <p class="mb-4">
            When you use the <strong>Random Coordinates</strong> tool and a map is displayed, your
            browser loads map tiles directly from the OpenStreetMap tile server operated by the{" "}
            <a
              href="https://osmfoundation.org"
              class="text-accent hover:text-accent-hover transition-colors"
              target="_blank"
              rel="noopener noreferrer">OpenStreetMap Foundation</a
            > (OSMF) at <code
              class="text-sm font-mono bg-surface-alt dark:bg-surface-alt-dark px-1 rounded"
              >tile.openstreetmap.org</code
            >. Each tile request reveals your IP address to OSMF servers. The Leaflet mapping
            library itself is bundled with this site and loaded locally - no data is sent to a CDN
            for the library assets.
          </p>
          <p>
            If you do not use the Random Coordinates tool, no tile requests are made. OSMF's privacy
            policy is available at{" "}
            <a
              href="https://wiki.osmfoundation.org/wiki/Privacy_Policy"
              class="text-accent hover:text-accent-hover transition-colors"
              target="_blank"
              rel="noopener noreferrer">wiki.osmfoundation.org/wiki/Privacy_Policy</a
            >.
          </p>
        </div>

        <hr class="border-border dark:border-border-dark" />

        <div>
          <h2
            class="text-sm uppercase tracking-wide font-semibold mb-2 text-text-primary dark:text-text-primary-dark"
          >
            9. Data Retention
          </h2>
          <p>
            Server access logs are retained according to the default rotation policy of the
            infrastructure and are deleted automatically. Rate-limit counters are held in memory
            only and are lost whenever the service restarts - they are never written to persistent
            storage.
          </p>
        </div>

        <hr class="border-border dark:border-border-dark" />

        <div>
          <h2
            class="text-sm uppercase tracking-wide font-semibold mb-2 text-text-primary dark:text-text-primary-dark"
          >
            10. Your Rights
          </h2>
          <p class="mb-4">Under GDPR, you have the right to:</p>
          <ul class="space-y-2 list-disc list-inside">
            <li>Access the personal data we hold about you (Art. 15)</li>
            <li>Rectification of inaccurate data (Art. 16)</li>
            <li>Erasure of your data ("right to be forgotten") (Art. 17)</li>
            <li>Restriction of processing (Art. 18)</li>
            <li>Data portability (Art. 20)</li>
            <li>Object to processing (Art. 21)</li>
            <li>
              Lodge a complaint with the Austrian Data Protection Authority (<a
                href="https://www.dsb.gv.at"
                class="text-accent hover:text-accent-hover transition-colors"
                target="_blank"
                rel="noopener noreferrer">dsb.gv.at</a
              >)
            </li>
          </ul>
          <p class="mt-4">
            To exercise your rights, contact us at <a
              href={`mailto:${privacyEmail}`}
              class="text-accent hover:text-accent-hover transition-colors">{privacyEmail}</a
            >.
          </p>
        </div>

        <hr class="border-border dark:border-border-dark" />

        <div>
          <h2
            class="text-sm uppercase tracking-wide font-semibold mb-2 text-text-primary dark:text-text-primary-dark"
          >
            11. Changes to This Policy
          </h2>
          <p>
            If we make material changes to this privacy policy, we will update this page. We
            encourage you to review it periodically. Continued use of ZaaS after changes constitutes
            acceptance of the updated policy.
          </p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
