# ZaaS - Zufall as a Service
# Copy this file to .env and edit as needed.
# The .env file is git-ignored.
# All variables have sensible defaults for local development  - 
# you can run the API with no .env file at all.

# -- API service --------------------------------------------------------------

# Port the API listens on
ZAAS_PORT=8080

# Public-facing base URL. Single source of truth for the domain.
# Change only this to move the service to a new domain.
ZAAS_BASE_URL=http://localhost:8080

# Log level: debug, info, warn, error
ZAAS_LOG_LEVEL=info

# Log format: text (human-readable, dev), json (production)
ZAAS_LOG_FORMAT=text

# Allowed CORS origins, comma-separated. "*" = allow all (tighten before exposing a dashboard).
ZAAS_CORS_ORIGINS=*

# Rate limiting
ZAAS_RATE_LIMIT_RPM=60        # Requests per minute per IP

# Rate limiting backend: "memory" (default, single-instance) or "redis" (distributed).
# When using "redis", ZAAS_REDIS_URL must also be set.
ZAAS_RATE_LIMIT_BACKEND=memory

# Redis connection URL (required when ZAAS_RATE_LIMIT_BACKEND=redis).
ZAAS_REDIS_URL=redis://redis:6379

# -- Database (PostgreSQL) ----------------------------------------------------
# PostgreSQL connection string. Used by the API at runtime.
ZAAS_DB_URL=postgres://zaas:zaas@postgres:5432/zaas?sslmode=disable

# Password for the PostgreSQL container user. Used by docker-compose.
# Change this in production to a strong password (openssl rand -base64 24).
POSTGRES_PASSWORD=zaas

# -- Email (SMTP) -------------------------------------------------------------
# Used by the API to send transactional emails (verification, re-issue).
# For local dev (make dev): SMTP is overridden to Mailpit (http://localhost:8025).
# No real emails are sent. The values below are for production (Migadu).
# Credentials are for the noreply@zaas.at Migadu mailbox.

ZAAS_SMTP_HOST=smtp.migadu.com
ZAAS_SMTP_PORT=587
ZAAS_SMTP_USER=
ZAAS_SMTP_PASSWORD=
ZAAS_SMTP_FROM=ZaaS <noreply@zaas.at>

# OpenTelemetry kill switch.
# Set false for bare `go run` without a Collector running.
ZAAS_OTEL_ENABLED=true

# Deployment environment label attached to every trace and metric.
# Used for deployment.environment resource attribute. Examples: development, staging, production.
ZAAS_ENVIRONMENT=development

# Expose /metrics Prometheus endpoint. Not reachable from the internet (see
# deploy/Caddyfile) - only Prometheus scrapes it inside the Docker network,
# and deploy/prometheus.yaml's "zaas-api" job expects it on. Keep true for
# the Docker Compose stack; the Go binary itself defaults to false when run
# standalone without a reverse proxy.
ZAAS_METRICS_ENDPOINT_ENABLED=true

# -- OpenTelemetry standard variables -----------------------------------------
# These are read directly by the OTel SDK - no ZAAS_ prefix.

OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=zaas-api
# Sampler ratio between 0.0 and 1.0. 1.0 = always sample, 0.1 = 10%. Default: 1.0.
OTEL_TRACES_SAMPLER_ARG=1.0

# -- Deployment ---------------------------------------------------------------

# Public domain for Caddy TLS (production only).
# Caddy automatically provisions a Let's Encrypt certificate for this domain.
# Unused in local dev (Caddyfile.local uses HTTP on :80).
ZAAS_DOMAIN=zaas.at

# Docker image for the web/Caddy service (production only).
# In production the deploy workflow pushes ghcr.io/haraig/zaas/web:latest.
# The redeploy webhook always pulls :latest, so a bad push immediately overwrites
# the previously running image - there is no "latest" to roll back to. Pin this to
# a known-good digest (logged by the deploy workflow, e.g. ghcr.io/haraig/zaas/web@sha256:<digest>)
# to roll back manually, or to any specific tag to hold back a deploy.
# ZAAS_WEB_IMAGE=ghcr.io/haraig/zaas/web:latest

# Docker image for the api service (production only).
# In production the deploy workflow pushes ghcr.io/haraig/zaas/api:latest.
# The redeploy webhook always pulls :latest, so a bad push immediately overwrites
# the previously running image - there is no "latest" to roll back to. Pin this to
# a known-good digest (logged by the deploy workflow, e.g. ghcr.io/haraig/zaas/api@sha256:<digest>)
# to roll back manually, or to any specific tag to hold back a deploy.
# ZAAS_API_IMAGE=ghcr.io/haraig/zaas/api:latest

# -- Auth ----------------------------------------------------------------------

# Admin token required for POST /auth/register and /auth/reissue (interim measure
# until CAPTCHA + a proper signup form ship). /auth/verify stays public.
# No default - fails closed (endpoints reject everyone) until set.
# Local dev (make dev / make dev-minimal) already presets a fixed value via
# docker-compose.local.yaml/minimal.yaml - no manual setup needed there.
# Generate a real value for production with: openssl rand -hex 32
ZAAS_ADMIN_TOKEN=

# -- CI/CD --------------------------------------------------------------------

# Shared secret for the /deploy-hook endpoint (GitHub Actions -> server).
# Used to verify the HMAC-SHA256 signature in X-Hub-Signature-256 on each deploy request.
# Generate with: openssl rand -hex 32
# Must match the DEPLOY_WEBHOOK_SECRET GitHub Actions secret.
DEPLOY_WEBHOOK_SECRET=

# -- Grafana ------------------------------------------------------------------

# Admin credentials for the Grafana UI (production only).
# Grafana is accessible at https://grafana.{ZAAS_DOMAIN} in production.
# In local dev, anonymous access is re-enabled via docker-compose.local.yml  - 
# these variables are not needed locally.
#
# GRAFANA_ADMIN_PASSWORD is required in production (no default).
# Choose a strong password. Grafana self-registration is disabled.
GRAFANA_ADMIN_USER=admin
# GRAFANA_ADMIN_PASSWORD=change-me-in-production

# -- Alerting -----------------------------------------------------------------

# How Alertmanager refers to itself when it builds a link (its .ExternalURL).
# Only affects link generation - it opens nothing and changes nothing about what
# is reachable from outside. Alertmanager stays bound to 127.0.0.1:9093 and the
# documented access path is an SSH tunnel, which is why localhost is the honest
# default. See docs/reference/runbook.md section 13.
#
# Leave unset unless the access path changes. If you do set it, keep it
# path-free: a path component also becomes the route prefix for Alertmanager's
# own UI.
# ZAAS_ALERTMANAGER_EXTERNAL_URL=http://localhost:9093

# -- Astro web (build-time) ---------------------------------------------------

# Disable Astro's anonymous telemetry data collection.
ASTRO_TELEMETRY_DISABLED=1

# Base URL for API calls from the browser.
# Set to the public domain at build time for production.
PUBLIC_API_BASE_URL=http://localhost:8080

# Imprint (legal requirement, Austrian ECG Section 5).
# Used at build time to populate the /imprint page.
# All values are required for production builds; the build fails if any are missing.
# In local dev (astro dev), missing values are silently replaced with placeholder text.
# Address supports newlines: use literal \n for line breaks.
PUBLIC_IMPRINT_NAME=
PUBLIC_IMPRINT_ADDRESS=
PUBLIC_IMPRINT_EMAIL=

# Privacy contact email (GDPR/DSGVO data requests).
# Used on /privacy and /datenschutz pages.
# Separate from imprint email for dedicated data subject request handling.
PUBLIC_PRIVACY_EMAIL=
