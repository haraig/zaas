[
  {
    "id": "redeploy",
    "execute-command": "/scripts/redeploy.sh",
    "command-working-directory": "/",
    "trigger-rule": {
      "match": {
        "type": "payload-hmac-sha256",
        "secret": "{{getenv "DEPLOY_WEBHOOK_SECRET"}}",
        "parameter": {
          "source": "header",
          "name": "X-Hub-Signature-256"
        }
      }
    }
  }
]
