# Normalize line endings to LF on commit
* text=auto eol=lf

# Explicitly text files
*.go      text eol=lf
*.ts      text eol=lf
*.astro   text eol=lf
*.css     text eol=lf
*.js      text eol=lf
*.mjs     text eol=lf
*.cjs     text eol=lf
*.json    text eol=lf
*.yaml    text eol=lf
*.yml     text eol=lf
*.md      text eol=lf
*.tf      text eol=lf
*.hcl     text eol=lf
*.sh      text eol=lf
*.toml    text eol=lf
*.html    text eol=lf
*.svg     text eol=lf

# Binary files - no line-ending conversion, no diff
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.ico     binary
*.wasm    binary
*.lock    binary
